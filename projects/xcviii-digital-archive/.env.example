# Copy to .env.local and fill in with values from your Supabase project
# (Settings -> API in the Supabase dashboard). Never commit the real file.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Test-only (RLS integration tests) — never read by the app itself. Needed for
# `npm run test`, not for `npm run dev`.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
